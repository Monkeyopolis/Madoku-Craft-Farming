{
	"schemaVersion": 1,
	"id": "madoku-craft-farming",
	"version": "${version}",
	"name": "madoku-craft-farming",
	"description": "A configurable farming overhaul system.",
	"authors": [
		"Monkeyopolis!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/madoku-craft-farming/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"madoku.craft.farming.Madokucraftfarming"
		],
		"client": [
			"madoku.craft.farming.MadokucraftfarmingClient"
		]
	},
	"mixins": [
		"madoku-craft-farming.mixins.json",
		{
			"config": "madoku-craft-farming.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.5",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"madoku-craft-api": ">=${madoku_craft_api_mod_version}"
	}
}
